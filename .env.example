# Boîte qui reçoit le PDF. À placer dans les secrets GitHub sous le nom OWNER_EMAIL.
OWNER_EMAIL=

# Envoi du PDF. Secrets GitHub : SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM.
# Gmail : hôte smtp.gmail.com, port 587, mot de passe d'application.
# Brevo : hôte smtp-relay.brevo.com, port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
